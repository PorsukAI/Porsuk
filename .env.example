# Copy to .env (git-ignored) and fill in only what the mode you're using
# needs. Nothing here is committed.

# --- The API's own auth key, required for every mode ---
PORSUK_API_KEY=

# --- Mode 1: OpenRouter (hosted, no GPU needed) ---
# config/openrouter.yaml reads this.
OPENROUTER_API_KEY=

# --- Mode 2: self-hosted vLLM, your own GPU or a rented one ---
# config/vllm.yaml reads these. See infra/README.md for renting a card.
# VLLM_BASE_URL=
# VLLM_MODEL=
# LLM_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_SPARSE_BASE_URL=
# RERANK_BASE_URL=
# VAST_API_KEY=

# --- Mode 2b: self-hosted MLX, Apple Silicon, no GPU rental ---
# config/mlx.yaml reads these; defaults point at localhost if unset.
# MLX_LLM_BASE_URL=http://localhost:8080/v1
# MLX_LLM_MODEL=
# MLX_EMBEDDING_BASE_URL=http://localhost:8081/v1
# MLX_EMBEDDING_MODEL=bge-m3

# --- Deployment ---
# Comma-separated list of allowed frontend origins for CORS.
# PORSUK_CORS_ORIGINS=http://localhost:9001

# Which config profile the API loads at startup (defaults to config/vllm.yaml
# if unset, pick the one matching the mode above).
# PORSUK_CONFIG=config/openrouter.yaml
